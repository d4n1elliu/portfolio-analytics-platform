# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string. Required: the API will not start without it.
# Paste the string from the Neon dashboard exactly as given.
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-west-2.aws.neon.tech/dbname?sslmode=require

# Secret used to sign login tokens (JWTs). Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# API key for the market data provider.
MARKET_DATA_API_KEY=replace-with-your-api-key

# Optional. Passwords of the two read-only demo accounts, shown on the sign in
# page. Leave them out to show "Available on request" instead. They must match
# the passwords the accounts were created with.
# DEMO_PASSWORD_PORTFOLIO_MANAGER=
# DEMO_PASSWORD_ANALYST=

# Optional settings. Each line shows the default used when it is left out.
# CORS_ORIGINS=http://localhost:5173
# MARKET_TIMEZONE=Australia/Sydney
# SESSION_MINUTES=480
# IMPORT_MAX_FILE_BYTES=1048576
# IMPORT_MAX_ROWS=5000
# PRICE_REFRESH_OVERLAP_DAYS=5
# PRICE_LOOKBACK_DAYS=365
# DEFAULT_PAGE_SIZE=50
# MAX_PAGE_SIZE=500
