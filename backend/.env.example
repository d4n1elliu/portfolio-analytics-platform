# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon). Not used until the database is set up.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# API key for the market data provider.
MARKET_DATA_API_KEY=replace-with-your-api-key
