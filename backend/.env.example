# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string. Required: the API will not start without it.
# This one is the local database started by docker-compose.dev.yml.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio

# Database for the tests that run real queries. They are skipped without it.
# Its tables are dropped and rebuilt by the tests, so the name must end in _test.
TEST_DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio_test

# Secret used to sign login tokens (JWTs). Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Optional settings. Each line shows the default used when it is left out.
# CORS_ORIGINS=http://localhost:5173
# MARKET_TIMEZONE=Australia/Sydney
# SESSION_MINUTES=480
# BENCHMARK_TICKER=VAS
# PASSWORD_LOCKED_EMAILS=
# AI_ENABLED=false
# IMPORT_MAX_FILE_BYTES=1048576
# IMPORT_MAX_ROWS=5000
# PRICE_REFRESH_OVERLAP_DAYS=5
# PRICE_LOOKBACK_DAYS=365
# DEFAULT_PAGE_SIZE=50
# MAX_PAGE_SIZE=500

# The AI features. Off by default. The key is needed only when they are on.
# The default embedding model runs on this machine and needs no key.
# AI_CHAT_MODEL=anthropic:claude-opus-5-5
# AI_EMBEDDING_MODEL=fastembed:BAAI/bge-small-en-v1.5
# AI_REQUESTS_PER_HOUR=20
# AI_DAILY_TOKEN_CAP=200000
# ANTHROPIC_API_KEY=replace-with-your-anthropic-key
# RESEARCH_MAX_FILE_BYTES=10485760

# Tracing. Off by default. When on, each answer's model and tool calls,
# including the portfolio data in them, are sent to LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=replace-with-your-langsmith-key
# LANGSMITH_PROJECT=portfolio-analytics
