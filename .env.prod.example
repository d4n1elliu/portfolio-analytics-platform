# Copy to .env.prod on the server and fill in real values. Never commit .env.prod.

# Domain the site is served on.
SITE_DOMAIN=portfolio-analytics.daniel-liu.dev

# Image version to run. Defaults to latest.
# IMAGE_TAG=latest

# PostgreSQL connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-west-2.aws.neon.tech/dbname?sslmode=require

# Secret for signing login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Accounts whose password cannot be changed, such as shared demo accounts.
# PASSWORD_LOCKED_EMAILS=operations@example.com,pm@example.com,analyst@example.com

# The AI features. Leave AI_ENABLED out to keep them off.
# AI_ENABLED=true
# ANTHROPIC_API_KEY=replace-with-your-anthropic-key
